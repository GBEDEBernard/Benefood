APP_NAME=Béninfood
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beninfood
DB_USERNAME=Bernard
DB_PASSWORD=Password123!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
BENINFOOD_IMAGES_DISK=public
BENINFOOD_DOCUMENTS_DISK=private

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bonjour@beninfood.bj"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum — jetons API mobiles (expiration en minutes)
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=bf_

# Béninfood — paramètres métier (voir config/beninfood.php)
BENINFOOD_VERSION=0.1.0
BENINFOOD_COMMISSION_RATE=10
BENINFOOD_PAYMENT_DEADLINE_MINUTES=15
BENINFOOD_VENDOR_ACCEPTANCE_MINUTES=5
BENINFOOD_CLIENT_WITHDRAWAL_MINUTES=10
BENINFOOD_DRIVER_OFFER_SECONDS=60
BENINFOOD_DRIVER_ACCEPTANCE_SECONDS=45
BENINFOOD_DEFAULT_COUNTRY_CODE=229
# Activer UNIQUEMENT quand FIREBASE_CREDENTIALS est renseigné (envoi FCM)
BENINFOOD_PUSH_ENABLED=false

# Kkiapay — remplacer par les clés fournies par la porteuse (sandbox puis prod)
KKIAPAY_ENABLED=false
KKIAPAY_SANDBOX=true
KKIAPAY_BASE_URL=https://api.kkiapay.me
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=

# Firebase — FCM (chemin du fichier service account JSON; vide tant que le push n'est pas testé)
FIREBASE_CREDENTIALS=
# FIREBASE_PROJECT=app
# FIREBASE_CACHE_STORE=file

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"