APP_NAME=Béninfood
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beninfood
DB_USERNAME=Bernard
DB_PASSWORD=Password123!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
BENINFOOD_IMAGES_DISK=public
BENINFOOD_DOCUMENTS_DISK=private

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bonjour@beninfood.bj"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum — jetons API mobiles (expiration en minutes)
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=bf_

# Béninfood — paramètres métier (voir config/beninfood.php)
BENINFOOD_VERSION=0.1.0
BENINFOOD_COMMISSION_RATE=10
BENINFOOD_PAYMENT_DEADLINE_MINUTES=15
BENINFOOD_VENDOR_ACCEPTANCE_MINUTES=5
BENINFOOD_CLIENT_WITHDRAWAL_MINUTES=10
BENINFOOD_DRIVER_OFFER_SECONDS=60
BENINFOOD_DRIVER_ACCEPTANCE_SECONDS=45
BENINFOOD_DEFAULT_COUNTRY_CODE=229
# Activer UNIQUEMENT quand FIREBASE_CREDENTIALS est renseigné (envoi FCM)
BENINFOOD_PUSH_ENABLED=false

# FedaPay — clés sandbox fournies par la porteuse (puis prod)
FEDAPAY_ENABLED=true
FEDAPAY_SANDBOX=true
FEDAPAY_BASE_URL=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# Calcul d'itinéraires — navigation livreur (voir config/beninfood.php)
# Priorité : Google Routes API, puis OpenRouteService, puis OSRM auto-hébergé.
GOOGLE_MAPS_API_KEY=
OPENROUTESERVICE_API_KEY=
BENINFOOD_ORS_URL=https://api.openrouteservice.org/v2/directions
# En production, pointer vers une instance OSRM auto-hébergée.
BENINFOOD_OSRM_URL=https://router.project-osrm.org
# Serveur de démonstration OSRM public : à laisser false hors développement.
BENINFOOD_ROUTING_ALLOW_PUBLIC_OSRM=false
BENINFOOD_ROUTING_TIMEOUT=6
BENINFOOD_ROUTING_CACHE_TTL=120

# Suivi temps réel — seuils partagés API/mobile
BENINFOOD_ETA_COEFFICIENT=1.3
BENINFOOD_STALE_WARN_S=30
BENINFOOD_STALE_HIDE_ETA_S=120
BENINFOOD_REROUTE_DEVIATION_M=50
BENINFOOD_REROUTE_MIN_INTERVAL_S=45
BENINFOOD_ARRIVAL_RADIUS_M=120
BENINFOOD_HISTORY_RETENTION_DAYS=30

# Tarification livraison selon la distance boutique → client (voir config/beninfood.php)
# ≤3 km = 500 ; progressif jusqu'à 8 km = 1000 ; palier 10 km ; +125/km ; puis +75/km
BENINFOOD_DELIVERY_MIN_FEE=500
BENINFOOD_DELIVERY_FLAT_KM=3
BENINFOOD_DELIVERY_BASE_KM=8
BENINFOOD_DELIVERY_BASE_FEE=1000
BENINFOOD_DELIVERY_INCLUDED_KM=10
BENINFOOD_DELIVERY_PER_KM=125
BENINFOOD_DELIVERY_DISCOUNT_KM=15
BENINFOOD_DELIVERY_DISCOUNTED_PER_KM=75
BENINFOOD_DELIVERY_DEFAULT_FEE=1000

# Firebase — FCM (chemin du fichier service account JSON; vide tant que le push n'est pas testé)
FIREBASE_CREDENTIALS=
# FIREBASE_PROJECT=app
# FIREBASE_CACHE_STORE=file

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"