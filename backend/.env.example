APP_NAME=Béninfood
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Compte admin créé au déploiement par ProductionSeeder
# ADMIN_NAME=GBEDE Bernard
# ADMIN_EMAIL=gbedebernard60@gmail.com
# Définir ADMIN_PASSWORD seulement pour remplacer le mot de passe par défaut.
# ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beninfood
DB_USERNAME=Bernard
DB_PASSWORD=Password123!
# CA TLS MySQL (ex. Render Secret File monté dans /etc/secrets/ca.pem)
# DB_SSL_CA=/etc/secrets/ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Médias publics : "public" (stockage local, dev) ou "s3" (R2 / Supabase / AWS S3 / MinIO)
# En production sur Render, utiliser "s3" pour éviter la perte des fichiers.
BENINFOOD_IMAGES_DISK=public
# Pièces justificatives privées : "private" (disque local, dev) ou "s3" (durable).
# Sur Render (disque éphémère), mettre "s3" sinon les documents sont perdus à
# chaque redéploiement.
BENINFOOD_DOCUMENTS_DISK=private

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bonjour@beninfood.bj"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum — jetons API mobiles (expiration en minutes)
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=bf_

# Béninfood — paramètres métier (voir config/beninfood.php)
BENINFOOD_VERSION=0.1.0
BENINFOOD_COMMISSION_RATE=10
BENINFOOD_PAYMENT_DEADLINE_MINUTES=15
BENINFOOD_VENDOR_ACCEPTANCE_MINUTES=5
BENINFOOD_CLIENT_WITHDRAWAL_MINUTES=10
BENINFOOD_DRIVER_OFFER_SECONDS=60
BENINFOOD_DRIVER_ACCEPTANCE_SECONDS=45
BENINFOOD_DEFAULT_COUNTRY_CODE=229
# Activer UNIQUEMENT quand FIREBASE_CREDENTIALS est renseigné (envoi FCM)
BENINFOOD_PUSH_ENABLED=false

# FedaPay — clés sandbox fournies par la porteuse (puis prod)
FEDAPAY_ENABLED=true
FEDAPAY_SANDBOX=true
FEDAPAY_BASE_URL=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# Calcul d'itinéraires — navigation livreur (voir config/beninfood.php)
# Priorité : Google Routes API, puis OpenRouteService, puis OSRM auto-hébergé.
GOOGLE_MAPS_API_KEY=
OPENROUTESERVICE_API_KEY=
BENINFOOD_ORS_URL=https://api.openrouteservice.org/v2/directions
# En production, pointer vers une instance OSRM auto-hébergée.
BENINFOOD_OSRM_URL=https://router.project-osrm.org
# Serveur de démonstration OSRM public : à laisser false hors développement.
BENINFOOD_ROUTING_ALLOW_PUBLIC_OSRM=false
BENINFOOD_ROUTING_TIMEOUT=6
BENINFOOD_ROUTING_CACHE_TTL=120

# Sélection d'un livreur proche — rayon, fraîcheur GPS et délai de réponse
BENINFOOD_DRIVER_SELECTION_RADIUS_KM=5
BENINFOOD_DRIVER_SELECTION_MAX_RADIUS_KM=15
BENINFOOD_DRIVER_SELECTION_LOCATION_MAX_AGE_S=300
BENINFOOD_DRIVER_SELECTION_REQUEST_TTL_S=120

# Suivi temps réel — seuils partagés API/mobile
BENINFOOD_ETA_COEFFICIENT=1.3
BENINFOOD_STALE_WARN_S=30
BENINFOOD_STALE_HIDE_ETA_S=120
BENINFOOD_REROUTE_DEVIATION_M=50
BENINFOOD_REROUTE_MIN_INTERVAL_S=45
BENINFOOD_ARRIVAL_RADIUS_M=120
BENINFOOD_MAX_ACTIVE_MISSIONS=2
BENINFOOD_HISTORY_RETENTION_DAYS=30

# Tarification livraison selon la distance boutique → client (voir config/beninfood.php)
# ≤3 km = 500 ; progressif jusqu'à 8 km = 1000 ; palier 10 km ; +125/km ; puis +75/km
BENINFOOD_DELIVERY_MIN_FEE=500
BENINFOOD_DELIVERY_FLAT_KM=3
BENINFOOD_DELIVERY_BASE_KM=8
BENINFOOD_DELIVERY_BASE_FEE=1000
BENINFOOD_DELIVERY_INCLUDED_KM=10
BENINFOOD_DELIVERY_PER_KM=125
BENINFOOD_DELIVERY_DISCOUNT_KM=15
BENINFOOD_DELIVERY_DISCOUNTED_PER_KM=75
BENINFOOD_DELIVERY_DEFAULT_FEE=1000

# Colis — frais fixe payé par le créateur, en plus de la livraison
BENINFOOD_PARCEL_CREATION_FEE=150

# Firebase — FCM : service account JSON. Sur Render, déposer le fichier comme
# Secret File nommé firebase.json ; entrypoint.sh le copie dans storage/.
FIREBASE_CREDENTIALS=
# FIREBASE_PROJECT=app
# FIREBASE_CACHE_STORE=file

# Géolocalisation centralisée — référentiel IGN Bénin (données ouvertes)
# Le géocodage reste côté serveur : aucune clé n'est envoyée à Flutter.
BENINFOOD_GEOCODING_PROVIDER=nominatim
BENINFOOD_NOMINATIM_URL=https://nominatim.openstreetmap.org
BENINFOOD_NOMINATIM_USER_AGENT="Beninfood/1.0 (contact@beninfood.bj)"
BENINFOOD_GEO_CACHE_TTL=3600
BENINFOOD_GEOCODING_CACHE_TTL=86400
BENINFOOD_GEOCODING_MIN_INTERVAL_MS=1100
BENINFOOD_TRACKING_MIN_INTERVAL_S=4
BENINFOOD_TRACKING_MAX_ACCURACY_M=100
BENINFOOD_TRACKING_IDLE_MIN_INTERVAL_S=15
# Diffusion temps réel désactivée : FCM + polling restent le canal actif.
BENINFOOD_TRACKING_BROADCAST_ENABLED=false
# Fournisseurs alternatifs (facultatifs) : mapbox / google
# MAPBOX_ACCESS_TOKEN=
# BENINFOOD_MAPBOX_GEOCODING_URL=https://api.mapbox.com/geocoding/v5/mapbox.places
# GOOGLE_GEOCODING_API_KEY=
# BENINFOOD_GOOGLE_GEOCODING_URL=https://maps.googleapis.com/maps/api/geocode/json

# Authentification sociale (OAuth 2.0 / OpenID Connect)
# Renseigner les identifiants créés sur chaque console fournisseur.
# GOOGLE_ALLOWED_CLIENT_IDS : IDs client supplémentaires (mobile/web), séparés par des virgules.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ALLOWED_CLIENT_IDS=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Stockage objet S3 — requis si BENINFOOD_IMAGES_DISK=s3 ou
# BENINFOOD_DOCUMENTS_DISK=s3
# R2 : AWS_DEFAULT_REGION=auto, AWS_USE_PATH_STYLE_ENDPOINT=true
# Supabase : AWS_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
#            AWS_URL=https://<ref>.supabase.co/storage/v1/object/public/<bucket>
#            AWS_DEFAULT_REGION=<région du projet>, AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_URL = URL publique du bucket, sans slash final.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Bucket séparé (privé) pour les pièces justificatives, si différent de AWS_BUCKET.
# AWS_DOCUMENTS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"